@model IReadOnlyList<App.Models.Maintain.FiscalYearListItemViewModel>
@{
    ViewData["Title"] = "年度管理";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1>年度管理</h1>
        <p class="text-muted mb-0">4月1日から翌年3月31日までの事業年度を管理します。</p>
    </div>
    <a class="btn btn-primary" asp-action="CreateFiscalYear">年度を登録</a>
</div>

@if (TempData["SuccessMessage"] is string message) {
    <div class="alert alert-success" role="status">@message</div>
}

@if (Model.Count == 0) {
    <div class="border rounded p-4 text-center">
        <p class="mb-0">年度が登録されていません。</p>
    </div>
} else {
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <caption class="visually-hidden">登録済み年度</caption>
            <thead>
                <tr>
                    <th scope="col">年度</th>
                    <th scope="col">名称</th>
                    <th scope="col">開始日</th>
                    <th scope="col">終了日</th>
                    <th scope="col">状態</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                    <tr>
                        <th scope="row">@item.Year</th>
                        <td>@item.Name</td>
                        <td>@item.StartsOn.ToString("yyyy/MM/dd")</td>
                        <td>@item.EndsOn.ToString("yyyy/MM/dd")</td>
                        <td>@item.StatusLabel</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
