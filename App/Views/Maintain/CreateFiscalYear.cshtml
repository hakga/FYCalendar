@model App.Models.Maintain.CreateFiscalYearViewModel
@{
    ViewData["Title"] = "年度登録";
}

<h1>年度登録</h1>
<p class="text-muted">年度と名称を入力してください。開始日と終了日は年度から自動設定します。</p>

<div class="row">
    <div class="col-lg-6">
        <form asp-action="CreateFiscalYear" method="post" data-fiscal-year-form>
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Year" class="form-label"></label>
                <input asp-for="Year" class="form-control" type="number" min="1" max="9998" step="1" required aria-describedby="YearHelp" />
                <div id="YearHelp" class="form-text">開始日の西暦年を指定します。例：2026年度は「2026」。</div>
                <span asp-validation-for="Year" class="text-danger" role="alert"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" maxlength="50" required />
                <span asp-validation-for="Name" class="text-danger" role="alert"></span>
            </div>
            <div class="mb-4">
                <label for="FiscalYearPeriod" class="form-label">期間（自動設定）</label>
                <output id="FiscalYearPeriod" class="d-block" aria-live="polite">
                    @if (Model.Period is { } period) {
                        @:@period.StartsOn.ToString("yyyy/MM/dd") ～ @period.EndsOn.ToString("yyyy/MM/dd")
                    } else {
                        @:有効な年度を入力すると期間が表示されます。
                    }
                </output>
                <div class="form-text">終了日の3月31日を含みます。登録時の状態は「運用中」です。</div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">登録する</button>
                <a asp-action="FiscalYears" class="btn btn-outline-secondary">一覧に戻る</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/maintain-fiscal-year.js" asp-append-version="true"></script>
}
