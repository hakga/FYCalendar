@model IReadOnlyList<App.Models.Calendars.TeamCalendarListItemViewModel>
@{
    ViewData["Title"] = "チームカレンダー";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1>チームカレンダー</h1>
        <p class="text-muted mb-0">チームごとのカレンダーを管理します。</p>
    </div>
    <a asp-action="CreateTeamCalendar" class="btn btn-primary">チームカレンダーを登録</a>
</div>

@if (TempData["SuccessMessage"] is string message) {
    <div class="alert alert-success" role="status">@message</div>
}

@if (Model.Count == 0) {
    <div class="border rounded p-4 text-center">
        <p class="mb-0">チームカレンダーが登録されていません。</p>
    </div>
} else {
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <caption class="visually-hidden">登録済みチームカレンダー</caption>
            <thead>
                <tr>
                    <th scope="col">カレンダーID</th>
                    <th scope="col">チーム</th>
                    <th scope="col">カレンダー名</th>
                    <th scope="col">種類</th>
                    <th scope="col">タイムゾーン</th>
                    <th scope="col">表示色</th>
                    <th scope="col">状態</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var calendar in Model) {
                    <tr>
                        <th scope="row">@calendar.Id</th>
                        <td><a asp-controller="Teams" asp-action="Members" asp-route-id="@calendar.TeamId">@calendar.TeamName（ID: @calendar.TeamId）</a></td>
                        <td>@calendar.Name</td>
                        <td>@calendar.CalendarTypeLabel</td>
                        <td>@calendar.TimeZoneId</td>
                        <td>@(calendar.DisplayColor ?? "未指定")</td>
                        <td>@calendar.StatusLabel</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
