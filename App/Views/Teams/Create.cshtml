@model App.Models.Teams.CreateTeamViewModel
@{
    ViewData["Title"] = "チーム登録";
}

<h1>チーム登録</h1>
<p class="text-muted">チーム名と、チームで使用するタイムゾーンを指定してください。</p>

<div class="row">
    <div class="col-lg-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" maxlength="200" required />
                <span asp-validation-for="Name" class="text-danger" role="alert"></span>
            </div>
            <div class="mb-4">
                <label asp-for="TimeZoneId" class="form-label"></label>
                <select asp-for="TimeZoneId" asp-items="Model.TimeZoneOptions" class="form-select" required></select>
                <span asp-validation-for="TimeZoneId" class="text-danger" role="alert"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">登録する</button>
                <a asp-action="Index" class="btn btn-outline-secondary">一覧に戻る</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
